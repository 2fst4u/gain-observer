{
  "name": "gain-visualiser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HF antenna gain visualizer — 3D radiation patterns, SWR, and NVIS/comparison modes powered by NEC-2 (WebAssembly).",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
